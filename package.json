{
  "name": "axnetccv2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/sync-public-css.mjs && vinext build && node scripts/sync-built-assets.mjs && vinext build",
    "start": "vinext start",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "local:check": "node --env-file=.env.local scripts/check-local-stack.mjs",
    "edge:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-agent-ollama.ps1",
    "edge:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-agent-ollama.ps1",
    "rag:compile": "node scripts/compile-rag-index.mjs",
    "eval:offline": "node scripts/evaluate-offline.mjs",
    "eval:expanded": "node scripts/evaluate-expanded.mjs"
    ,"eval:learning-curve": "node scripts/evaluate-router-learning-curve.mjs"
    ,"eval:statistics": "node scripts/evaluate-statistical-validity.mjs"
    ,"eval:validate-dataset": "node scripts/validate-evaluation-dataset.mjs"
    ,"eval:generate-candidates": "node scripts/generate-ax-candidate-set.mjs"
    ,"eval:annotate-openai": "node scripts/annotate-candidates-openai.mjs"
    ,"eval:merge-openai": "node scripts/merge-openai-annotations.mjs"
    ,"eval:annotate-multillm": "node scripts/annotate-candidates-multillm.mjs"
    ,"eval:analyze-multillm": "node scripts/analyze-candidates-multillm.mjs"
    ,"eval:annotate-openai-blind": "node scripts/annotate-openai-blind-roles.mjs"
    ,"eval:analyze-openai-blind": "node scripts/analyze-openai-blind-roles.mjs"
    ,"evidence:emulation": "node emulation/emulation-supervisor.mjs"
    ,"eval:security-evidence": "node scripts/run-security-evidence-experiment.mjs"
    ,"eval:security-evidence:analyze": "node scripts/analyze-security-evidence-results.mjs"
    ,"paper:security-evidence": "node scripts/build-security-evidence-paper-package.mjs"
    ,"eval:security-evidence:derive-40": "node scripts/derive-security-evidence-role-concepts.mjs"
    ,"eval:security-evidence:validate": "node scripts/validate-security-evidence-run.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
