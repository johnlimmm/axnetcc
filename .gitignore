# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-demo-server*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/deploy/
/deploy-stage/
public/*.js
public/index-*.css
/.local-edge/
/corpus/raw/
/corpus/processed/
/corpus/index/
__pycache__/
*.py[cod]
/paper/rendered/

# Evaluation artifacts are deny-by-default. Keep only reviewed, reproducible summaries.
/reports/*
!/reports/README.md
!/reports/primary-routing-benchmark/
/reports/primary-routing-benchmark/*
!/reports/primary-routing-benchmark/README.md
!/reports/primary-routing-benchmark/routing-benchmark-summary.csv
!/reports/primary-routing-benchmark/routing-benchmark-per-query.csv
!/reports/primary-routing-benchmark/routing-benchmark-results.json
!/reports/primary-routing-benchmark/routing-quality.png
!/reports/primary-routing-benchmark/routing-efficiency.png
!/reports/scheduler-benchmark-v1.json
!/reports/scheduler-benchmark-v1.svg
