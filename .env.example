LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_TIMEOUT_MS=90000

# Core -> Edge RAG/Agent transport.
# auto/local is a single-process prototype boundary only. Production should use remote.
EDGE_AGENT_MODE=auto
EDGE_AGENT_REQUIRE_REMOTE=false
EDGE_AGENT_TIMEOUT_MS=30000
# Edge API 배포에서는 endpoint마다 하나의 Agent ID로 고정합니다.
EDGE_AGENT_ID=
EDGE_AGENT_BASE_URL=
EDGE_AGENT_TOKEN=
# Optional per-Agent remote overrides:
# EDGE_AGENT_SECURITY_BASE_URL=https://security-edge.internal.example
# EDGE_AGENT_SECURITY_TOKEN=

# Optional OpenAI-compatible commercial LLM used only as a blind evaluator.
# Only the masked query, Edge summaries, evidence IDs/classes, and metrics are sent.
COMMERCIAL_JUDGE_BASE_URL=
COMMERCIAL_JUDGE_API_KEY=
COMMERCIAL_JUDGE_MODEL=gpt-5.4-mini

# Optional per-Agent overrides. Agents share the default Ollama runtime unless overridden.
LOCAL_LLM_TECH_BASE_URL=http://127.0.0.1:11441
LOCAL_LLM_TECH_MODEL=qwen2.5:0.5b
LOCAL_LLM_DATA_BASE_URL=http://127.0.0.1:11442
LOCAL_LLM_DATA_MODEL=qwen2.5:0.5b
LOCAL_LLM_SECURITY_BASE_URL=http://127.0.0.1:11443
LOCAL_LLM_SECURITY_MODEL=qwen2.5:0.5b
LOCAL_LLM_LEGAL_BASE_URL=http://127.0.0.1:11444
LOCAL_LLM_LEGAL_MODEL=qwen2.5:0.5b
LOCAL_LLM_POLICY_BASE_URL=http://127.0.0.1:11445
LOCAL_LLM_POLICY_MODEL=qwen2.5:0.5b
LOCAL_LLM_FINANCE_BASE_URL=http://127.0.0.1:11446
LOCAL_LLM_FINANCE_MODEL=qwen2.5:0.5b
LOCAL_LLM_PROCUREMENT_BASE_URL=http://127.0.0.1:11447
LOCAL_LLM_PROCUREMENT_MODEL=qwen2.5:0.5b
LOCAL_LLM_OPERATIONS_BASE_URL=http://127.0.0.1:11448
LOCAL_LLM_OPERATIONS_MODEL=qwen2.5:0.5b
